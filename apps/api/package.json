{
  "name": "@sonora/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prebuild": "pnpm --filter @sonora/database build",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
