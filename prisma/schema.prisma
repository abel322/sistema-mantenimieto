generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String               @id @default(cuid())
  email              String               @unique
  name               String
  password           String
  role               UserRole             @default(TECHNICIAN)
  workOrders         WorkOrder[]
  checklistExecutions ChecklistExecution[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
}

model Asset {
  id                  String               @id @default(uuid())
  name                String
  code                String               @unique
  area                AssetArea
  criticality         Int                  @default(2)
  description         String?
  imageUrl            String?
  workOrders          WorkOrder[]
  maintenanceLogs     MaintenanceLog[]
  failureLogs         FailureLog[]
  schedules           Schedule[]
  checklistExecutions ChecklistExecution[]
  tools               Tool[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([area])
  @@index([code])
}

model WorkOrder {
  id                   String              @id @default(cuid())
  title                String
  description          String
  type                 OrderType
  status               Status              @default(OPEN)
  priority             Priority            @default(MEDIUM)
  assetId              String
  asset                Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade)
  guidelineId          String?
  guideline            TechnicalGuideline? @relation(fields: [guidelineId], references: [id], onDelete: SetNull)
  checklist            Json?
  checklistExecutionId String?
  checklistExecution   ChecklistExecution? @relation(fields: [checklistExecutionId], references: [id], onDelete: SetNull)
  taskPlanId           String?
  taskPlan             TaskPlan?           @relation(fields: [taskPlanId], references: [id], onDelete: SetNull)
  partsUsed            PartOnOrder[]
  materials            WorkOrderMaterial[]
  tools                WorkOrderTool[]
  technicianId         String
  technician           User                @relation(fields: [technicianId], references: [id])
  externalVendorId     String?
  externalVendor       Supplier?           @relation(fields: [externalVendorId], references: [id], onDelete: SetNull)
  images               String[]            @default([])
  laborHours           Float?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  closedAt             DateTime?

  @@index([status])
  @@index([assetId])
  @@index([technicianId])
  @@index([guidelineId])
  @@index([checklistExecutionId])
  @@index([taskPlanId])
  @@index([externalVendorId])
}

model Part {
  id                  String         @id @default(uuid())
  name                String
  code                String         @unique
  stock               Int            @default(0)
  minStock            Int            @default(5)
  price               Float
  unit                String         @default("unidad")
  category            String?
  preferredSupplierId String?
  preferredSupplier   Supplier?      @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  workOrders          PartOnOrder[]
  workOrderMaterials  WorkOrderMaterial[]
  planMaterials       PlanMaterial[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([code])
  @@index([preferredSupplierId])
}

model Supplier {
  id          String      @id @default(uuid())
  name        String
  taxId       String?
  category    String
  contactName String?
  phone       String?
  email       String?
  address     String?
  status      String      @default("ACTIVE")
  rating      Int?
  notes       String?
  parts       Part[]
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
  @@index([status])
  @@index([name])
}

model PartOnOrder {
  id          String    @id @default(uuid())
  workOrderId String
  partId      String
  quantity    Int
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part        Part      @relation(fields: [partId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@index([partId])
}

model Schedule {
  id            String   @id @default(uuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  frequencyDays Int?
  frequencyType FrequencyType @default(CALENDAR)
  nextDueDate   DateTime
  taskTemplate  String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([assetId])
  @@index([nextDueDate])
}

model FailureLog {
  id            String   @id @default(uuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  symptom       String
  rootCause     String?
  downtimeHours Float    @default(0)
  reportedAt    DateTime @default(now())
  resolvedAt    DateTime?

  @@index([assetId])
  @@index([reportedAt])
}

model MaintenanceLog {
  id            String   @id @default(uuid())
  assetId       String
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  workOrderId   String   @unique
  summary       String
  totalCost     Float    @default(0)
  executionDate DateTime @default(now())

  @@index([assetId])
  @@index([executionDate])
}

model ChecklistTemplate {
  id          String               @id @default(uuid())
  title       String
  description String?
  assetType   String?
  isActive    Boolean              @default(true)
  items       ChecklistItem[]
  executions  ChecklistExecution[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([assetType])
  @@index([isActive])
}

model ChecklistItem {
  id            String            @id @default(uuid())
  templateId    String
  template      ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  label         String
  type          ChecklistItemType @default(BOOLEAN)
  isRequired    Boolean           @default(true)
  defaultOption String?
  minValue      Float?
  maxValue      Float?
  responses     ChecklistResponse[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([templateId])
}

model ChecklistExecution {
  id           String            @id @default(uuid())
  templateId   String
  template     ChecklistTemplate @relation(fields: [templateId], references: [id])
  assetId      String
  asset        Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technicianId String
  technician   User              @relation(fields: [technicianId], references: [id])
  status       ExecutionStatus   @default(PASSED)
  completedAt  DateTime          @default(now())
  notes        String?
  responses    ChecklistResponse[]
  workOrders   WorkOrder[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([assetId])
  @@index([technicianId])
  @@index([templateId])
  @@index([status])
}

model ChecklistResponse {
  id           String             @id @default(uuid())
  executionId  String
  execution    ChecklistExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  itemId       String
  item         ChecklistItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  valueBoolean Boolean?
  valueNumeric Float?
  valueText    String?
  isFlagged    Boolean            @default(false)
  notes        String?
  createdAt    DateTime           @default(now())

  @@index([executionId])
  @@index([itemId])
}

model TaskPlan {
  id               String        @id @default(uuid())
  title            String
  description      String?
  assetType        String
  frequency        String
  estimatedMinutes Int
  machineStatus    MachineStatus @default(STOPPED_LOTO)
  requiredSkill    String
  tools            String[]      @default([])
  safetyEquipment  String[]      @default([])
  steps            TaskStep[]
  materials        PlanMaterial[]
  workOrders       WorkOrder[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([assetType])
  @@index([frequency])
}

model TaskStep {
  id           String   @id @default(uuid())
  planId       String
  plan         TaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  stepNumber   Int
  description  String
  referenceVal String?
  isMandatory  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([planId])
}

model PlanMaterial {
  id           String   @id @default(uuid())
  planId       String
  plan         TaskPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  partId       String?
  part         Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  materialName String
  quantity     Float
  unit         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([planId])
  @@index([partId])
}

enum UserRole {
  ADMIN
  SUPERVISOR
  TECHNICIAN
}

enum AssetArea {
  EXTRUSION
  PRINTING
  SEALING
  SLITTING
  RECYCLING
  MIXING
  POWER_PLANT
  AUXILIARY
  GENERAL
}

enum OrderType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
}

enum Status {
  OPEN
  IN_PROGRESS
  ON_HOLD
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FrequencyType {
  CALENDAR
  USAGE_HOURS
  USAGE_METERS
}

enum ChecklistItemType {
  BOOLEAN
  NUMERIC
  TEXT
}

enum ExecutionStatus {
  PASSED
  FLAGGED
  FAILED
}

enum MachineStatus {
  STOPPED_LOTO
  RUNNING
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   // 'STOCK_ALERT' | 'SCHEDULE_DUE' | 'WORK_ORDER_OVERDUE'
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@index([type])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([endpoint])
  @@index([userId])
}

model Tool {
  id           String     @id @default(uuid())
  code         String     @unique
  name         String
  category     String
  type         ToolType
  status       ToolStatus @default(AVAILABLE)
  brand        String?
  serialNumber String?
  assetId      String?
  asset        Asset?     @relation(fields: [assetId], references: [id], onDelete: SetNull)
  area         String?
  assignedTo   String?
  assignedAt   DateTime?
  notes        String?
  workOrderTools WorkOrderTool[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([code])
  @@index([status])
  @@index([type])
  @@index([assetId])
}

model TechnicalGuideline {
  id          String      @id @default(uuid())
  code        String      @unique
  title       String
  description String?
  category    String?
  isActive    Boolean     @default(true)
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model WorkOrderMaterial {
  id              String    @id @default(uuid())
  workOrderId     String
  workOrder       WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   Part      @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  quantityUsed    Float
  createdAt       DateTime  @default(now())

  @@index([workOrderId])
  @@index([inventoryItemId])
}

model WorkOrderTool {
  id          String    @id @default(uuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  toolId      String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@index([toolId])
}

enum ToolType {
  FIXED_MACHINE
  FIXED_AREA
  PORTABLE
}

enum ToolStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

